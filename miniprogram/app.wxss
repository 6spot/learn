page { --background: #F5F6F8; --text: #202329; --secondary: #626B78; --divider: #E9ECF0; --accent: #3578E5; background: var(--background); color: var(--text); font-size: 16px; }
.section-title { font-size: 20px; line-height: 1.5; font-weight: 600; }
.secondary { color: var(--secondary); font-size: 12px; line-height: 1.5; }
button.button-plain { width: auto; margin: 0; padding: 0; border: 0; border-radius: 0; background: transparent; color: inherit; font-size: inherit; }
.button-plain::after { border: 0; }
button.text-action { min-height: 44px; line-height: 44px; padding: 0 4px; font-size: 14px; color: var(--accent); }
button.button-primary, button.button-secondary { width: 100%; font-size: 16px; line-height: 48px; min-height: 48px; border-radius: 8px; }
.button-primary { background: var(--accent); color: #FFFFFF; }
.button-secondary { background: #F0F3F8; color: var(--text); }
.button-primary::after, .button-secondary::after { border: 0; }
button[disabled] { color: #8A929E !important; }
.button-primary[disabled] { background: #E6EAF0 !important; }
.button-plain[disabled] { background: transparent !important; }
.page-actions { padding-top: 22px; padding-bottom: calc(20px + env(safe-area-inset-bottom)); }
.action-note { display: block; margin-top: 8px; text-align: center; font-size: 12px; color: var(--secondary); line-height: 1.5; }
