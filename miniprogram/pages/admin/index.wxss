page { background: #FFFFFF; }
.admin-page { padding-bottom: calc(20px + env(safe-area-inset-bottom)); }
.admin-section { padding: 22px 20px; border-bottom: 12px solid var(--background); }
.date-section { padding-bottom: 12px; }
.date-actions { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; margin-top: 8px; }
.date-actions picker, .date-label { flex: 1; min-width: 155px; }
.date-picker { min-height: 44px; display: flex; align-items: center; flex-wrap: wrap; gap: 8px; font-size: 18px; }
.date-hint { font-size: 12px; color: var(--accent); }
.state-section > text, .metric > text, .section-note, .coverage-row > text { display: block; }
.state-section .secondary { margin-top: 8px; }
.state-section button { margin-top: 18px; }
.metrics { display: flex; flex-wrap: wrap; margin-top: 4px; }
.metric { width: 50%; box-sizing: border-box; padding: 20px 12px 20px 0; border-bottom: 1px solid var(--divider); }
.metric:nth-child(even) { padding-left: 12px; padding-right: 0; }
.metric-label { font-size: 14px; }
.metric-value { font-size: 30px; line-height: 1.35; margin: 8px 0; overflow-wrap: anywhere; }
.generated-at { display: block; margin-top: 18px; margin-bottom: 6px; }
.section-note { margin: 6px 0 12px; }
.template-row { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; padding: 17px 0; border-bottom: 1px solid var(--divider); }
.template-count { text-align: right; overflow-wrap: anywhere; }
.coverage-row { padding: 14px 0; border-bottom: 1px solid var(--divider); }
.coverage-row .secondary { margin-top: 4px; }
.coverage-note { display: block; margin-top: 16px; }
.coverage-section { border-bottom: 0; }
