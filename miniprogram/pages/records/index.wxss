page { background: #FFFFFF; }
.records-page { padding: 0 20px calc(24px + env(safe-area-inset-bottom)); }
.records-toolbar { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 10px 0; border-bottom: 1px solid var(--divider); }
button.record-row { width: 100%; text-align: left; padding: 20px 0; line-height: 1.6; border-bottom: 1px solid var(--divider); }
.record-heading { display: flex; justify-content: space-between; gap: 16px; align-items: baseline; margin-bottom: 8px; }
.record-template { font-weight: 600; }
.record-state { font-size: 14px; text-align: right; }
.record-row > .secondary { display: block; margin-top: 4px; }
.records-empty, .records-notice { padding: 30px 0; line-height: 1.6; }
.records-empty > text, .records-notice > text { display: block; }
.records-empty .secondary, .records-notice .secondary { margin-top: 8px; }
.records-empty button, .records-notice button { margin-top: 20px; }
.records-footer { padding-top: 22px; }
.query-time, .records-note { display: block; margin-top: 12px; }
