{
  "name": "learn",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json && npm --prefix packages/paper-core run build",
    "test:core": "npm --prefix packages/paper-core test",
    "test:cloud": "npm --prefix packages/cloud-runtime test",
    "test:runtime": "npm run build && node --test packages/runtime-smoke/test/*.test.mjs",
    "test": "npm run typecheck && npm run test:core && npm run test:runtime && npm run test:cloud",
    "smoke": "npm run build && node scripts/runtime-report.mjs",
    "test:devtools": "npm run build && node scripts/test-devtools.mjs --diagnostics"
  },
  "devDependencies": {
    "esbuild": "0.25.10",
    "miniprogram-automator": "0.12.1",
    "typescript": "5.9.3"
  }
}
